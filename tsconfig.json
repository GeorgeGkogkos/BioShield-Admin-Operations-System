{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "src",
    "outDir": "static/typed",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
